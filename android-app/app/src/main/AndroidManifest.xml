<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.tuuniversidad.ecosistema">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="Ecosistema"
        android:theme="@style/AppTheme"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true">

        <activity
            android:name="com.tuuniversidad.ecosistema.controller.CheckoutActivity"
            android:exported="false" />
        <activity
            android:name="com.tuuniversidad.ecosistema.controller.CartActivity"
            android:exported="false" />
        <activity
            android:name="com.tuuniversidad.ecosistema.controller.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
