<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🛒 Mi Carrito"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="#1976D2"
        android:padding="14dp" />

    <TextView
        android:id="@+id/tvCarritoVacio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="El carrito está vacío. Regresa al catálogo y agrega productos."
        android:padding="20dp"
        android:gravity="center"
        android:textSize="15sp"
        android:textColor="#9E9E9E"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerCarrito"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#E3F2FD">

        <TextView
            android:id="@+id/tvSubtotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Subtotal: $ 0"
            android:textSize="14sp"
            android:textColor="#424242" />

        <TextView
            android:id="@+id/tvEnvio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Envío: $ 8.000"
            android:textSize="14sp"
            android:textColor="#424242"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TOTAL: $ 0"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1976D2"
            android:layout_marginTop="6dp" />

        <Button
            android:id="@+id/btnProcederPago"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✅ Proceder al Pago"
            android:backgroundTint="#2E7D32"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginTop="10dp" />

    </LinearLayout>

</LinearLayout>
